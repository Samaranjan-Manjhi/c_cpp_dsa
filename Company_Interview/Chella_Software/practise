Q: What functions are used for dynamic memory in C?
A: malloc, calloc, realloc, free - all declared in <stdlib.h>.

--------------------------------------------------------------
2.1 malloc - allocate uninitialized memory
--------------------------------------------------------------
#include <stdlib.h>
#include <stdio.h>

int main(void) {
    int *arr = (int *)malloc(5 * sizeof(int));  // 5 ints, uninitialized
    if (arr == NULL) {
        // ALWAYS check the return value - malloc can fail
        fprintf(stderr, "Allocation failed\n");
        return 1;
    }

    for (int i = 0; i < 5; i++)
        arr[i] = i * i;

    for (int i = 0; i < 5; i++)
        printf("%d ", arr[i]);

    free(arr);      // release memory
    arr = NULL;     // avoid dangling pointer - good practice
    return 0;
}

KEY POINTS TO SAY OUT LOUD:
- malloc's memory is uninitialized (garbage values) - unlike calloc.
- Always check for NULL before using the returned pointer.
- Always free what you malloc, and set the pointer to NULL after,
  to avoid accidental use-after-free (dangling pointer).

--------------------------------------------------------------
2.2 calloc - allocate zero-initialized memory
--------------------------------------------------------------
int *arr = (int *)calloc(5, sizeof(int));  // 5 ints, all zeroed
if (arr == NULL) { /* handle error */ }
// arr[0] through arr[4] are guaranteed to be 0

KEY POINT: calloc(n, size) takes two arguments and zero-initializes
the memory - useful when you need a clean starting state, at a small
extra cost vs malloc for the zeroing step.

--------------------------------------------------------------
2.3 realloc - resize an existing allocation
--------------------------------------------------------------
int *arr = (int *)malloc(5 * sizeof(int));
// ... use arr ...

int *temp = (int *)realloc(arr, 10 * sizeof(int));  // grow to 10 ints
if (temp == NULL) {
    // realloc failed - ORIGINAL arr is still valid and must be freed
    free(arr);
    return 1;
}
arr = temp;  // safe to reassign now

KEY POINT (common interview trap): never do
    arr = realloc(arr, newSize);
directly - if realloc fails and returns NULL, you lose the original
pointer and leak memory. Always assign to a temporary variable first.

--------------------------------------------------------------
2.4 free - release memory
--------------------------------------------------------------
free(arr);
arr = NULL;

COMMON BUGS TO MENTION PROACTIVELY:
1. Memory leak - forgetting to free() allocated memory.
2. Double free - calling free() twice on the same pointer (undefined
   behavior, can corrupt the heap allocator's internal structures).
3. Dangling pointer - using a pointer after it's been freed.
4. Freeing memory not allocated by malloc/calloc/realloc (e.g.,
   freeing a stack variable's address) - undefined behavior.

--------------------------------------------------------------
2.5 Small worked example: dynamic array that grows (likely style
    of "easy-to-medium" live coding question)
--------------------------------------------------------------
#include <stdio.h>
#include <stdlib.h>

typedef struct {
    int *data;
    int size;      // current number of elements
    int capacity;  // allocated capacity
} DynArray;

void initArray(DynArray *a, int initialCapacity) {
    a->data = (int *)malloc(initialCapacity * sizeof(int));
    a->size = 0;
    a->capacity = initialCapacity;
}

void pushBack(DynArray *a, int value) {
    if (a->size == a->capacity) {
        int newCapacity = a->capacity * 2;
        int *temp = (int *)realloc(a->data, newCapacity * sizeof(int));
        if (temp == NULL) {
            fprintf(stderr, "Reallocation failed\n");
            return;
        }
        a->data = temp;
        a->capacity = newCapacity;
    }
    a->data[a->size++] = value;
}

void freeArray(DynArray *a) {
    free(a->data);
    a->data = NULL;
    a->size = 0;
    a->capacity = 0;
}

int main(void) {
    DynArray a;
    initArray(&a, 2);

    for (int i = 0; i < 10; i++)
        pushBack(&a, i);

    for (int i = 0; i < a.size; i++)
        printf("%d ", a.data[i]);
    printf("\n");

    freeArray(&a);
    return 0;
}

WHY THIS IS A GOOD ANSWER TO KNOW: it demonstrates malloc, realloc
with the safe temp-variable pattern, struct usage, and proper cleanup
all together - a realistic "write me a simple dynamic array" prompt.

