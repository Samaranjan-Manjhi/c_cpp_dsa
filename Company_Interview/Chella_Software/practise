--------------------------------------------------------------
Q1: BAD PRACTICE - "SELECT * fetches unnecessary data"
--------------------------------------------------------------
SELECT * FROM Orders WHERE cust_id = 1;
-- EXPLANATION: fetches ALL columns even if you only need order_id
-- and order_date - wastes I/O and network bandwidth at scale.

--------------------------------------------------------------
Q1 FIX: "fetch only needed columns"
--------------------------------------------------------------
SELECT order_id, order_date FROM Orders WHERE cust_id = 1;
-- EXPLANATION: reduces the amount of data read and transferred,
-- especially important on large tables with many columns.

--------------------------------------------------------------
Q2: EXPLAIN PLAN - "see how the engine will execute a query"
--------------------------------------------------------------
EXPLAIN SELECT * FROM Orders WHERE cust_id = 1;
-- EXPLANATION: shows whether the engine does a full table scan
-- or uses an index - tells you if you need to add an index here.

--------------------------------------------------------------
Q3: FUNCTION ON INDEXED COLUMN - "why this skips the index"
--------------------------------------------------------------
-- BAD:
SELECT * FROM Orders WHERE YEAR(order_date) = 2026;
-- GOOD:
SELECT * FROM Orders WHERE order_date >= '2026-01-01' AND order_date < '2027-01-01';
-- EXPLANATION: wrapping the column in YEAR() forces the engine to
-- evaluate the function on every row, bypassing any index on
-- order_date. The range version can use the index directly.

--------------------------------------------------------------
Q4: N+1 PROBLEM - "bad: querying items per order in a loop"
--------------------------------------------------------------
-- BAD (pseudo-loop, one query PER order):
-- for each order: SELECT * FROM OrderItems WHERE order_id = ?
-- GOOD (single batched query):
SELECT o.order_id, oi.product_id, oi.quantity
FROM Orders o
JOIN OrderItems oi ON o.order_id = oi.order_id;
-- EXPLANATION: the loop version runs N extra queries for N orders;
-- the JOIN version fetches everything needed in a single round-trip.

--------------------------------------------------------------
Q5: RELATIONAL ALGEBRA - Selection (σ) and Projection (π) together
--------------------------------------------------------------
SELECT name FROM Customers WHERE city = 'Mumbai';
-- EXPLANATION: this is π(name)( σ(city='Mumbai')(Customers) ) -
-- Selection filters rows first, Projection then picks the column.

--------------------------------------------------------------
Q6: RELATIONAL ALGEBRA - Join (⋈)
--------------------------------------------------------------
SELECT c.name, p.name AS product, oi.quantity
FROM Customers c
JOIN Orders o ON c.cust_id = o.cust_id
JOIN OrderItems oi ON o.order_id = oi.order_id
JOIN Products p ON oi.product_id = p.product_id;
-- EXPLANATION: chains multiple joins (⋈) across four relations to
-- reconstruct "which customer bought which product."


================================================================
DATABASE 3: "NormalizationDemo" - for NORMALIZATION (1NF, 2NF, 3NF)
================================================================

--------------------------------------------------------------
STEP 0: THE UNNORMALIZED TABLE (violates 1NF)
--------------------------------------------------------------
CREATE TABLE StudentCourses_BAD (
    student_id   INT,
    student_name VARCHAR(50),
    courses      VARCHAR(200)   -- e.g., "Math,Science,English" - repeating group!
);
-- PROBLEM: 'courses' stores multiple values in one column - not
-- atomic, violates 1NF, and makes searching for one course painful.

--------------------------------------------------------------
STEP 1: FIX TO 1NF - atomic values, one course per row
--------------------------------------------------------------
CREATE TABLE StudentCourses_1NF (
    student_id   INT,
    student_name VARCHAR(50),
    course_id    INT,
    course_name  VARCHAR(50),
    instructor   VARCHAR(50)
);
-- Now each row has ONE course - atomic values achieved.
-- PROBLEM REMAINING: student_name repeats for every course row
-- (redundancy), and course_name/instructor repeat per course too.

--------------------------------------------------------------
STEP 2: FIX TO 2NF - remove partial dependency
--------------------------------------------------------------
-- Composite key here would be (student_id, course_id).
-- student_name depends only on student_id (partial dependency) -
-- so split it out:
CREATE TABLE Students (
    student_id   INT PRIMARY KEY,
    student_name VARCHAR(50)
);

CREATE TABLE Enrollments_2NF (
    student_id   INT,
    course_id    INT,
    course_name  VARCHAR(50),
    instructor   VARCHAR(50),
    PRIMARY KEY (student_id, course_id),
    FOREIGN KEY (student_id) REFERENCES Students(student_id)
);
-- Now student_name is stored once per student, not once per
-- enrollment row - partial dependency removed.

--------------------------------------------------------------
STEP 3: FIX TO 3NF - remove transitive dependency
--------------------------------------------------------------
-- instructor depends on course_id, NOT on the (student,course)
-- key directly - that's a transitive dependency. Split it out:
CREATE TABLE Courses (
    course_id   INT PRIMARY KEY,
    course_name VARCHAR(50),
    instructor  VARCHAR(50)
);

CREATE TABLE Enrollments_3NF (
    student_id INT,
    course_id  INT,
    PRIMARY KEY (student_id, course_id),
    FOREIGN KEY (student_id) REFERENCES Students(student_id),
    FOREIGN KEY (course_id) REFERENCES Courses(course_id)
);
-- Now instructor/course_name live in ONE place (Courses table),
-- not duplicated across every enrollment - fully 3NF.

--------------------------------------------------------------
QUERY TO PROVE IT STILL WORKS AFTER NORMALIZING (via JOIN)
--------------------------------------------------------------
SELECT s.student_name, c.course_name, c.instructor
FROM Students s
JOIN Enrollments_3NF e ON s.student_id = e.student_id
JOIN Courses c ON e.course_id = c.course_id;
-- EXPLANATION: this is the tradeoff of normalization - data is no
-- longer duplicated, but reading it back together now requires
-- JOINs. This is the exact point to make if asked about the
-- normalization vs read-performance tradeoff in a low-latency
-- financial system.

