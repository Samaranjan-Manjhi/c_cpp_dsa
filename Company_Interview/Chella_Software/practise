#include <stdio.h>
#include <stdlib.h>

// Define the node structure
struct Node {
    int data;
    struct Node* next;
};

// Function to create a new node
struct Node* createNode(int data) {
    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
    if (newNode == NULL) {
        printf("Memory allocation failed\n");
        exit(1);
    }
    newNode->data = data;
    newNode->next = NULL;
    return newNode;
}

// Function to detect cycle, get its length, and remove it
void detectAndHandleCycle(struct Node* head) {
    struct Node *slow = head, *fast = head;
    int hasCycle = 0;

    // 1. Detect cycle using Floyd's Tortoise and Hare Algorithm
    while (fast != NULL && fast->next != NULL) {
        slow = slow->next;
        fast = fast->next->next;
        if (slow == fast) {
            hasCycle = 1;
            break;
        }
    }

    if (!hasCycle) {
        printf("No cycle detected in the linked list.\n");
        return;
    }

    printf("Cycle detected!\n");

    // 2. Calculate cycle length
    int length = 1;
    struct Node* temp = slow;
    while (temp->next != slow) {
        length++;
        temp = temp->next;
    }
    printf("Cycle length: %d\n", length);

    // 3. Remove the cycle
    slow = head;
    if (slow == fast) {
        // Special case: Cycle starts at the head node
        while (fast->next != slow) {
            fast = fast->next;
        }
        fast->next = NULL;
    } else {
        // Standard case: Find the node just before the start of the cycle
        while (slow->next != fast->next) {
            slow = slow->next;
            fast = fast->next;
        }
        fast->next = NULL; // Break the cycle
    }
    printf("Cycle has been successfully removed.\n");
}

// Function to print the linked list safely (prevents infinite loop if cycle exists)
void printListSafe(struct Node* head) {
    struct Node* temp = head;
    int count = 0;
    while (temp != NULL && count < 20) { // Limit iterations to avoid infinite loop
        printf("%d -> ", temp->data);
        temp = temp->next;
        count++;
    }
    if (temp != NULL) {
        printf("... (Cycle detected, stopping print)\n");
    } else {
        printf("NULL\n");
    }
}

int main() {
    // Create nodes
    struct Node* head = createNode(10);
    head->next = createNode(20);
    head->next->next = createNode(30);
    head->next->next->next = createNode(40);
    head->next->next->next->next = createNode(50);

    // Intentionally create a cycle: point node 50 back to node 30
    head->next->next->next->next->next = head->next->next;

    // Attempt to detect, measure, and delete the cycle
    detectAndHandleCycle(head);

    // Verify the list after cycle removal
    printf("List after removing cycle:\n");
    printListSafe(head);

    // Free allocated memory
    struct Node* temp;
    while (head != NULL) {
        temp = head;
        head = head->next;
        free(temp);
    }

    return 0;
}


