#include <stdio.h>
#include <stdlib.h>

// Define the node structure
struct Node {
    int data;
    struct Node* next;
};

// Function to create a new node
struct Node* createNode(int data) {
    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
    if (newNode == NULL) {
        printf("Memory allocation failed\n");
        exit(1);
    }
    newNode->data = data;
    newNode->next = NULL;
    return newNode;
}

// Function to detect cycle, get its length, and remove it
void detectAndHandleCycle(struct Node* head) {
    struct Node *slow = head, *fast = head;
    int hasCycle = 0;

    // 1. Detect cycle using Floyd's Tortoise and Hare Algorithm
    while (fast != NULL && fast->next != NULL) {
        slow = slow->next;
        fast = fast->next->next;
        if (slow == fast) {
            hasCycle = 1;
            break;
        }
    }

    if (!hasCycle) {
        printf("No cycle detected in the linked list.\n");
        return;
    }

    printf("Cycle detected!\n");

    // 2. Calculate cycle length
    int length = 1;
    struct Node* temp = slow;
    while (temp->next != slow) {
        length++;
        temp = temp->next;
    }
    printf("Cycle length: %d\n", length);

    // 3. Remove the cycle
    slow = head;
    if (slow == fast) {
        // Special case: Cycle starts at the head node
        while (fast->next != slow) {
            fast = fast->next;
        }
        fast->next = NULL;
    } else {
        // Standard case: Find the node just before the start of the cycle
        while (slow->next != fast->next) {
            slow = slow->next;
            fast = fast->next;
        }
        fast->next = NULL; // Break the cycle
    }
    printf("Cycle has been successfully removed.\n");
}

// Function to print the linked list safely (prevents infinite loop if cycle exists)
void printListSafe(struct Node* head) {
    struct Node* temp = head;
    int count = 0;
    while (temp != NULL && count < 20) { // Limit iterations to avoid infinite loop
        printf("%d -> ", temp->data);
        temp = temp->next;
        count++;
    }
    if (temp != NULL) {
        printf("... (Cycle detected, stopping print)\n");
    } else {
        printf("NULL\n");
    }
}

int main() {
    // Create nodes
    struct Node* head = createNode(10);
    head->next = createNode(20);
    head->next->next = createNode(30);
    head->next->next->next = createNode(40);
    head->next->next->next->next = createNode(50);

    // Intentionally create a cycle: point node 50 back to node 30
    head->next->next->next->next->next = head->next->next;

    // Attempt to detect, measure, and delete the cycle
    detectAndHandleCycle(head);

    // Verify the list after cycle removal
    printf("List after removing cycle:\n");
    printListSafe(head);

    // Free allocated memory
    struct Node* temp;
    while (head != NULL) {
        temp = head;
        head = head->next;
        free(temp);
    }

    return 0;
}


C DATABASE OPERATIONS (SQLite via C) + COMPLETE SQL REFERENCE
================================================================
NOTE: Plain C has no built-in database - it uses a library. SQLite
is the most common one to demonstrate in an interview since it's a
single C API (sqlite3.h) with no separate server needed.
================================================================


PART A: C CODE - DATABASE OPERATIONS USING SQLITE
================================================================
Compile with: gcc file.c -lsqlite3 -o file

--------------------------------------------------------------
A1. CREATE / OPEN A DATABASE
--------------------------------------------------------------
Opening a DB file creates it if it doesn't already exist.
sqlite3_open() returns a connection handle used for all operations.

#include <sqlite3.h>
#include <stdio.h>

int main(void) {
    sqlite3 *db;
    int rc = sqlite3_open("company.db", &db);   // creates file if missing
    if (rc != SQLITE_OK) {
        fprintf(stderr, "Cannot open DB: %s\n", sqlite3_errmsg(db));
        return 1;
    }
    printf("Database opened successfully\n");
    sqlite3_close(db);
    return 0;
}

--------------------------------------------------------------
A2. CREATE TABLE
--------------------------------------------------------------
sqlite3_exec() runs a raw SQL string directly against the DB.
Good for one-shot statements like CREATE TABLE that need no input data.

char *errMsg = 0;
const char *sql = "CREATE TABLE Employees(id INT PRIMARY KEY, name TEXT, salary INT);";
int rc = sqlite3_exec(db, sql, 0, 0, &errMsg);
if (rc != SQLITE_OK) {
    fprintf(stderr, "SQL error: %s\n", errMsg);
    sqlite3_free(errMsg);
}

--------------------------------------------------------------
A3. INSERT VALUE (using prepared statement - safer than sqlite3_exec)
--------------------------------------------------------------
Prepared statements avoid SQL injection and let you bind values
safely instead of building raw SQL strings by concatenation.

sqlite3_stmt *stmt;
const char *sql = "INSERT INTO Employees(id, name, salary) VALUES(?, ?, ?);";

sqlite3_prepare_v2(db, sql, -1, &stmt, NULL);
sqlite3_bind_int(stmt, 1, 101);
sqlite3_bind_text(stmt, 2, "Ravi", -1, SQLITE_STATIC);
sqlite3_bind_int(stmt, 3, 90000);

if (sqlite3_step(stmt) != SQLITE_DONE)
    fprintf(stderr, "Insert failed: %s\n", sqlite3_errmsg(db));

sqlite3_finalize(stmt);   // always finalize to free the statement

--------------------------------------------------------------
A4. SELECT / READ VALUES (using a callback function)
--------------------------------------------------------------
sqlite3_exec() with a callback runs SELECT and invokes your
function once per returned row, giving column names/values as arrays.

int callback(void *unused, int argc, char **argv, char **colName) {
    for (int i = 0; i < argc; i++)
        printf("%s = %s\n", colName[i], argv[i] ? argv[i] : "NULL");
    printf("---\n");
    return 0;
}

sqlite3_exec(db, "SELECT * FROM Employees;", callback, 0, &errMsg);

--------------------------------------------------------------
A5. UPDATE VALUE
--------------------------------------------------------------
Same prepared-statement pattern as INSERT - bind new value and
the WHERE condition value, then execute with sqlite3_step().

const char *sql = "UPDATE Employees SET salary = ? WHERE id = ?;";
sqlite3_prepare_v2(db, sql, -1, &stmt, NULL);
sqlite3_bind_int(stmt, 1, 95000);
sqlite3_bind_int(stmt, 2, 101);
sqlite3_step(stmt);
sqlite3_finalize(stmt);

--------------------------------------------------------------
A6. DELETE A ROW
--------------------------------------------------------------
Deletes matching rows only; table structure remains untouched.
Same prepared-statement pattern, just with a DELETE SQL string.

const char *sql = "DELETE FROM Employees WHERE id = ?;";
sqlite3_prepare_v2(db, sql, -1, &stmt, NULL);
sqlite3_bind_int(stmt, 1, 101);
sqlite3_step(stmt);
sqlite3_finalize(stmt);

--------------------------------------------------------------
A7. DROP TABLE / CLOSE DATABASE
--------------------------------------------------------------
DROP TABLE removes the table and its data entirely (structure gone).
sqlite3_close() releases the connection - always call it before exit.

sqlite3_exec(db, "DROP TABLE Employees;", 0, 0, &errMsg);
sqlite3_close(db);


