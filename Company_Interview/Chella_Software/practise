DATABASE 1: "CompanyDB" - for JOINS, INDEXES, SELF-JOIN
================================================================

-- SCHEMA
CREATE TABLE Departments (
    dept_id   INT PRIMARY KEY,
    dept_name VARCHAR(50)
);

CREATE TABLE Employees (
    emp_id    INT PRIMARY KEY,
    name      VARCHAR(50),
    dept_id   INT,
    mgr_id    INT,          -- manager's emp_id (for self-join)
    salary    INT,
    FOREIGN KEY (dept_id) REFERENCES Departments(dept_id)
);

-- SAMPLE DATA
INSERT INTO Departments VALUES (1, 'Engineering'), (2, 'Sales'), (3, 'HR');

INSERT INTO Employees VALUES
(101, 'Ravi',   1, NULL, 90000),   -- Ravi is a manager, no mgr himself
(102, 'Anita',  1, 101,  70000),
(103, 'Suresh', 2, NULL, 60000),
(104, 'Meena',  2, 103,  50000),
(105, 'Farhan', NULL, NULL, 55000); -- no department assigned (for LEFT/RIGHT demo)

--------------------------------------------------------------
Q1: INNER JOIN - "show employees with their department names"
--------------------------------------------------------------
SELECT e.name, d.dept_name
FROM Employees e
INNER JOIN Departments d ON e.dept_id = d.dept_id;
-- EXPLANATION: only returns rows where dept_id matches in BOTH
-- tables. Farhan (dept_id = NULL) is excluded from the result.

--------------------------------------------------------------
Q2: LEFT JOIN - "show ALL employees, even those with no department"
--------------------------------------------------------------
SELECT e.name, d.dept_name
FROM Employees e
LEFT JOIN Departments d ON e.dept_id = d.dept_id;
-- EXPLANATION: keeps every row from Employees; Farhan appears
-- with dept_name = NULL since he has no matching department.

--------------------------------------------------------------
Q3: RIGHT JOIN - "show all departments, even ones with no employees"
--------------------------------------------------------------
SELECT e.name, d.dept_name
FROM Employees e
RIGHT JOIN Departments d ON e.dept_id = d.dept_id;
-- EXPLANATION: keeps every row from Departments; HR (dept_id=3)
-- would show up with name = NULL since no employee is in HR.

--------------------------------------------------------------
Q4: SELF JOIN - "show each employee alongside their manager's name"
--------------------------------------------------------------
SELECT a1.name AS employee, a2.name AS manager
FROM Employees a1
LEFT JOIN Employees a2 ON a1.mgr_id = a2.emp_id;
-- EXPLANATION: joins the Employees table to itself using mgr_id,
-- so we can resolve a manager's ID into their actual name.

--------------------------------------------------------------
Q5: INDEX - "speed up lookups by department"
--------------------------------------------------------------
CREATE INDEX idx_emp_dept ON Employees(dept_id);
-- EXPLANATION: without this, filtering WHERE dept_id = X requires
-- scanning every row (full table scan). With the index, the
-- engine can jump directly to matching rows via a B-tree lookup.

--------------------------------------------------------------
Q6: COMPOSITE INDEX - "speed up lookups by dept AND salary together"
--------------------------------------------------------------
CREATE INDEX idx_dept_salary ON Employees(dept_id, salary);
-- EXPLANATION: useful for queries filtering/sorting on BOTH
-- columns together, e.g., WHERE dept_id=1 ORDER BY salary DESC;
-- column order matters - this index doesn't help a salary-only filter.


