DATABASE 2: "ECommerceDB" - for QUERY OPTIMIZATION, RELATIONAL ALGEBRA
================================================================

-- SCHEMA
CREATE TABLE Customers (
    cust_id   INT PRIMARY KEY,
    name      VARCHAR(50),
    city      VARCHAR(50)
);

CREATE TABLE Products (
    product_id INT PRIMARY KEY,
    name       VARCHAR(50),
    price      DECIMAL(10,2)
);

CREATE TABLE Orders (
    order_id   INT PRIMARY KEY,
    cust_id    INT,
    order_date DATE,
    FOREIGN KEY (cust_id) REFERENCES Customers(cust_id)
);

CREATE TABLE OrderItems (
    order_id   INT,
    product_id INT,
    quantity   INT,
    FOREIGN KEY (order_id) REFERENCES Orders(order_id),
    FOREIGN KEY (product_id) REFERENCES Products(product_id)
);

-- SAMPLE DATA
INSERT INTO Customers VALUES (1,'Rahul','Mumbai'), (2,'Sneha','Pune');
INSERT INTO Products VALUES (10,'Laptop',60000.00), (11,'Mouse',500.00);
INSERT INTO Orders VALUES (100, 1, '2026-08-01'), (101, 2, '2026-08-15');
INSERT INTO OrderItems VALUES (100,10,1), (100,11,2), (101,11,1);

--------------------------------------------------------------
Q1: BAD PRACTICE - "SELECT * fetches unnecessary data"
--------------------------------------------------------------
SELECT * FROM Orders WHERE cust_id = 1;
-- EXPLANATION: fetches ALL columns even if you only need order_id
-- and order_date - wastes I/O and network bandwidth at scale.

--------------------------------------------------------------
Q1 FIX: "fetch only needed columns"
--------------------------------------------------------------
SELECT order_id, order_date FROM Orders WHERE cust_id = 1;
-- EXPLANATION: reduces the amount of data read and transferred,
-- especially important on large tables with many columns.

--------------------------------------------------------------
Q2: EXPLAIN PLAN - "see how the engine will execute a query"
--------------------------------------------------------------
EXPLAIN SELECT * FROM Orders WHERE cust_id = 1;
-- EXPLANATION: shows whether the engine does a full table scan
-- or uses an index - tells you if you need to add an index here.

--------------------------------------------------------------
Q3: FUNCTION ON INDEXED COLUMN - "why this skips the index"
--------------------------------------------------------------
-- BAD:
SELECT * FROM Orders WHERE YEAR(order_date) = 2026;
-- GOOD:
SELECT * FROM Orders WHERE order_date >= '2026-01-01' AND order_date < '2027-01-01';
-- EXPLANATION: wrapping the column in YEAR() forces the engine to
-- evaluate the function on every row, bypassing any index on
-- order_date. The range version can use the index directly.

--------------------------------------------------------------
Q4: N+1 PROBLEM - "bad: querying items per order in a loop"
--------------------------------------------------------------
-- BAD (pseudo-loop, one query PER order):
-- for each order: SELECT * FROM OrderItems WHERE order_id = ?
-- GOOD (single batched query):
SELECT o.order_id, oi.product_id, oi.quantity
FROM Orders o
JOIN OrderItems oi ON o.order_id = oi.order_id;
-- EXPLANATION: the loop version runs N extra queries for N orders;
-- the JOIN version fetches everything needed in a single round-trip.

--------------------------------------------------------------
Q5: RELATIONAL ALGEBRA - Selection (σ) and Projection (π) together
--------------------------------------------------------------
SELECT name FROM Customers WHERE city = 'Mumbai';
-- EXPLANATION: this is π(name)( σ(city='Mumbai')(Customers) ) -
-- Selection filters rows first, Projection then picks the column.

--------------------------------------------------------------
Q6: RELATIONAL ALGEBRA - Join (⋈)
--------------------------------------------------------------
SELECT c.name, p.name AS product, oi.quantity
FROM Customers c
JOIN Orders o ON c.cust_id = o.cust_id
JOIN OrderItems oi ON o.order_id = oi.order_id
JOIN Products p ON oi.product_id = p.product_id;
-- EXPLANATION: chains multiple joins (⋈) across four relations to
-- reconstruct "which customer bought which product."


