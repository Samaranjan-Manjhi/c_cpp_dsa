#include <pthread.h>
#include <stdio.h>

#define QUEUE_SIZE 10

int queue[QUEUE_SIZE];
int count = 0, in = 0, out = 0;

pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
pthread_cond_t not_empty = PTHREAD_COND_INITIALIZER;
pthread_cond_t not_full  = PTHREAD_COND_INITIALIZER;

void *producer(void *arg) {
    for (int i = 0; i < 20; i++) {
        pthread_mutex_lock(&lock);
        while (count == QUEUE_SIZE)          // queue full - wait
            pthread_cond_wait(&not_full, &lock);

        queue[in] = i;
        in = (in + 1) % QUEUE_SIZE;
        count++;
        printf("Produced: %d\n", i);

        pthread_cond_signal(&not_empty);     // wake a consumer
        pthread_mutex_unlock(&lock);
    }
    return NULL;
}

void *consumer(void *arg) {
    for (int i = 0; i < 20; i++) {
        pthread_mutex_lock(&lock);
        while (count == 0)                   // queue empty - wait
            pthread_cond_wait(&not_empty, &lock);

        int val = queue[out];
        out = (out + 1) % QUEUE_SIZE;
        count--;
        printf("Consumed: %d\n", val);

        pthread_cond_signal(&not_full);      // wake the producer
        pthread_mutex_unlock(&lock);
    }
    return NULL;
}

int main(void) {
    pthread_t t1, t2;
    pthread_create(&t1, NULL, producer, NULL);
    pthread_create(&t2, NULL, consumer, NULL);
    pthread_join(t1, NULL);
    pthread_join(t2, NULL);
    return 0;
}

KEY POINTS TO SAY OUT LOUD:
- Always check the wait condition in a while loop, not an if - spurious
  wakeups can occur, and multiple consumers might race to grab the item.
- mutex protects the shared queue state; condition variable avoids
  busy-waiting/polling, which wastes CPU.
- This maps directly to "fanotify thread produces events, worker
  threads consume and hash" in a project like MW Guardian.

Q: "How would you avoid false sharing if multiple worker threads are
updating per-thread counters/stats?"
A: "Pad each thread's counter struct so it occupies its own cache
line - e.g., align to 64 bytes - so that one thread updating its
counter doesn't invalidate the cache line for another thread's
counter, which would otherwise cause unnecessary cache-coherency
traffic between cores."


SECTION 3: DEBUGGING - TIED TO YOUR PROJECTS
================================================================

Q: "How would you debug MW Guardian if it's intermittently missing
file modification events?"
A: "First check whether it's a coverage issue - is fanotify actually
watching the right mount points/paths, since fanotify has mount-level
vs path-level watching modes and it's easy to miss events outside the
watched scope. If coverage is correct, I'd suspect the ring/event
buffer between the kernel notification and the userspace handler is
overflowing under load, dropping events - I'd check for a backlog/
overflow counter and add logging around buffer capacity."

Q: "How would you debug a crash in the eBPF userspace agent under
load?"
A: "Get a core dump and run it through GDB to get the backtrace,
check if it's happening in the ring buffer read path (common if the
consumer isn't keeping up and overwrites data mid-read), and run
under Valgrind or ASan in a lower-load test environment first since
those tools slow things down and can hide timing-dependent issues
present only under real load."

Q: "How would you debug a deadlock in the multithreaded worker pool?"
A: "Use GDB to attach to the running process, then 'thread apply all
bt' to get backtraces of every thread at once - this shows exactly
which locks each thread is waiting on and holding, which usually
reveals the circular wait directly. Prevention going forward: enforce
a consistent lock acquisition order across the codebase."


SECTION 4: TCP vs UDP - CODE + WHY
================================================================

CORE DIFFERENCE (say this first, then code if asked):
- TCP: connection-oriented, reliable, ordered, has flow/congestion
  control. Higher overhead (handshake, acks, retransmission) but
  guarantees delivery and order.
- UDP: connectionless, no reliability/ordering guarantee, minimal
  overhead - just send and hope. Lower latency, no handshake.

WHY THIS MATTERS IN TRADING/FINANCIAL SYSTEMS (important framing):
Market data feeds are very often UDP (sometimes multicast UDP) because
speed matters more than guaranteed delivery of every single packet -
a slightly stale price is worse to wait for than to occasionally miss
one update that gets corrected by the next tick. Order entry/execution
paths (placing an actual trade), by contrast, need TCP or an
equivalent reliable protocol, because losing an order message is
unacceptable - you need guaranteed, ordered delivery even at the cost
of some latency.

--------------------------------------------------------------
4.1 TCP - simple client/server in C
--------------------------------------------------------------
// --- TCP SERVER ---
#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

int main(void) {
    int server_fd = socket(AF_INET, SOCK_STREAM, 0);   // TCP = SOCK_STREAM

    struct sockaddr_in addr;
    memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET;
    addr.sin_addr.s_addr = INADDR_ANY;
    addr.sin_port = htons(8080);

    bind(server_fd, (struct sockaddr *)&addr, sizeof(addr));
    listen(server_fd, 5);          // start listening, backlog of 5

    int client_fd = accept(server_fd, NULL, NULL);  // blocks until connect

    char buf[256];
    ssize_t n = read(client_fd, buf, sizeof(buf) - 1);
    buf[n] = '\0';
    printf("Received: %s\n", buf);

    write(client_fd, "ACK", 3);    // reliable, ordered response

    close(client_fd);
    close(server_fd);
    return 0;
}

// --- TCP CLIENT ---
#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

int main(void) {
    int sock = socket(AF_INET, SOCK_STREAM, 0);

    struct sockaddr_in addr;
    memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET;
    addr.sin_port = htons(8080);
    inet_pton(AF_INET, "127.0.0.1", &addr.sin_addr);

    connect(sock, (struct sockaddr *)&addr, sizeof(addr));  // handshake
    write(sock, "Hello TCP", 9);

    char buf[256];
    ssize_t n = read(sock, buf, sizeof(buf) - 1);
    buf[n] = '\0';
    printf("Server replied: %s\n", buf);

    close(sock);
    return 0;
}

KEY POINTS TO SAY: connect() performs the 3-way handshake; the socket
type SOCK_STREAM signals TCP; read/write behave like a continuous
byte stream, not discrete messages.

--------------------------------------------------------------
4.2 UDP - simple client/server in C
--------------------------------------------------------------
// --- UDP SERVER ---
#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

int main(void) {
    int sock = socket(AF_INET, SOCK_DGRAM, 0);   // UDP = SOCK_DGRAM

    struct sockaddr_in addr;
    memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET;
    addr.sin_addr.s_addr = INADDR_ANY;
    addr.sin_port = htons(9090);

    bind(sock, (struct sockaddr *)&addr, sizeof(addr));
    // NOTE: no listen()/accept() - UDP is connectionless

    char buf[256];
    struct sockaddr_in client_addr;
    socklen_t len = sizeof(client_addr);

    ssize_t n = recvfrom(sock, buf, sizeof(buf) - 1, 0,
                          (struct sockaddr *)&client_addr, &len);
    buf[n] = '\0';
    printf("Received: %s\n", buf);

    sendto(sock, "ACK", 3, 0, (struct sockaddr *)&client_addr, len);

    close(sock);
    return 0;
}

// --- UDP CLIENT ---
#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

int main(void) {
    int sock = socket(AF_INET, SOCK_DGRAM, 0);

    struct sockaddr_in addr;
    memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET;
    addr.sin_port = htons(9090);
    inet_pton(AF_INET, "127.0.0.1", &addr.sin_addr);

    sendto(sock, "Hello UDP", 9, 0, (struct sockaddr *)&addr, sizeof(addr));

    char buf[256];
    socklen_t len = sizeof(addr);
    ssize_t n = recvfrom(sock, buf, sizeof(buf) - 1, 0,
                          (struct sockaddr *)&addr, &len);
    buf[n] = '\0';
    printf("Server replied: %s\n", buf);

    close(sock);
    return 0;
}

KEY POINTS TO SAY: no connect()/handshake needed (though connect()
CAN optionally be used with UDP to fix the peer address); sendto/
recvfrom carry the destination/source address per-packet since
there's no persistent connection; each sendto is a discrete
datagram, not a byte stream - message boundaries are preserved,
unlike TCP.

--------------------------------------------------------------
4.3 Likely follow-up: "How do you handle reliability if you must
    use UDP for speed but still need to know a packet was lost?"
--------------------------------------------------------------
A: "Add a lightweight application-level sequence number to each UDP
packet. The receiver tracks the last sequence number seen - if it
detects a gap, it knows a packet was lost and can either request a
retransmit or simply note the gap and move on, depending on whether
the data is a self-correcting stream (like market data ticks, where
the next update supersedes the missed one) or something that
actually requires recovery."

