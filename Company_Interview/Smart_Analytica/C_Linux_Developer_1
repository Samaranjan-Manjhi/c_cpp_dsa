using namespace std;

int getCountOfsubstr(const string& s, const string& st)
{
	int res = 0;
	int n = s.length();
	int m = st.length();
	if(n == 0 || m == 0 || n < m)
		return res;

	for(int i=0;i<=n-m;)
	{
		bool isMatch = true;
		for(int j=0;j<m;j++)
		{
			if(s[i+j] != st[j])
			{
				isMatch = false;
				break;
			}
		}

		if(isMatch)
		{
			res += 1;
			i += m;
		}
		else
		{
			i++;
		}
	}

	return res;
}

