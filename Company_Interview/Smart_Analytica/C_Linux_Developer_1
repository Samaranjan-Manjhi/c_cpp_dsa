## 6.1 [ADDED] Thread-safe Queue in C (item #1 above — was completely missing)
```c
#include <pthread.h>
#include <stdlib.h>

typedef struct Node { int data; struct Node* next; } Node;

typedef struct {
    Node *head, *tail;
    pthread_mutex_t lock;
    pthread_cond_t not_empty;
} SafeQueue;

void queue_init(SafeQueue *q) {
    q->head = q->tail = NULL;
    pthread_mutex_init(&q->lock, NULL);
    pthread_cond_init(&q->not_empty, NULL);
}

void queue_push(SafeQueue *q, int val) {
    Node *n = malloc(sizeof(Node));
    n->data = val; n->next = NULL;

    pthread_mutex_lock(&q->lock);
    if (q->tail) q->tail->next = n; else q->head = n;
    q->tail = n;
    pthread_cond_signal(&q->not_empty);   // wake one waiting consumer
    pthread_mutex_unlock(&q->lock);
}

int queue_pop(SafeQueue *q) {
    pthread_mutex_lock(&q->lock);
    while (q->head == NULL) {
        pthread_cond_wait(&q->not_empty, &q->lock); // sleeps, releases lock
    }
    Node *n = q->head;
    int val = n->data;
    q->head = n->next;
    if (!q->head) q->tail = NULL;
    pthread_mutex_unlock(&q->lock);
    free(n);
    return val;
}
// Key talking point: condition variable avoids busy-waiting/polling —
// consumer thread sleeps until producer signals, instead of spinning
// on a while(empty) loop burning CPU.
```

