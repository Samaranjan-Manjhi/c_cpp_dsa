using namespace std;

void doSwap(string& s, int start, int end)
{
	if(s.empty())
		return;
	while(start < end)
	{
		swap(s[start++], s[end--]);
	}
}

void reverseWord(string& s)
{
	int n = s.length();
	if(n == 0)
		return;
	int start = 0;
	doSwap(s, 0, n-1);
	for(int i=0;i<=n;i++)
	{
		if(i == n || s[i] == ' ')
		{
			doSwap(s, start, i-1);
			start = i+1;
		}
	}
