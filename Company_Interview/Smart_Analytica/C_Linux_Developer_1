void detectCycle(struct Node* head) {
 
    // ---------- PART 1: DETECT (Floyd's slow/fast pointer) ----------
    struct Node* slow = head;
    struct Node* fast = head;
    int hasCycle = 0;
 
    while (fast != NULL && fast->next != NULL) {
        slow = slow->next;
        fast = fast->next->next;
        if (slow == fast) {
            hasCycle = 1;
            break;              // slow and fast met inside the loop
        }
    }
 
    if (!hasCycle) {
        printf("No cycle detected.\n");
        return;
    }
 
    printf("Cycle detected! Meeting point value = %d\n", slow->data);
 
    // ---------- PART 2: LENGTH ----------
    // walk forward from the meeting point until we land back on it
    int length = 1;
    struct Node* temp = slow->next;
    while (temp != slow) {
        temp = temp->next;
        length++;
    }
    printf("Cycle length = %d\n", length);
 
    // ---------- PART 3: START OF CYCLE ----------
    // reset one pointer to head, move both one step at a time
    struct Node* ptr1 = head;
    struct Node* ptr2 = slow;
    while (ptr1 != ptr2) {
        ptr1 = ptr1->next;
        ptr2 = ptr2->next;
    }
    struct Node* cycleStart = ptr1;   // == ptr2
    printf("Cycle starts at node with value = %d\n", cycleStart->data);
 
    // ---------- PART 4: DELETE THE CYCLE ----------
    // walk around the loop until we find the node whose ->next
    // points back to cycleStart, then break the link there
    struct Node* lastNode = cycleStart;
    while (lastNode->next != cycleStart) {
        lastNode = lastNode->next;
    }
    lastNode->next = NULL;
 
    printf("\nCycle removed. List is now linear:\n");
    printList(head);
}
 
// =====================================================
// MAIN — build 1->2->3->4->5->6, wire a cycle back to node "3"
// =====================================================
int main() {
    int values[] = {1, 2, 3, 4, 5, 6};
    int n = sizeof(values) / sizeof(values[0]);
 
    struct Node* head = buildList(values, n);
 
    // Manually create a cycle for testing: last node (6) -> node holding 3
    struct Node* tail = getNodeAt(head, n - 1);
    struct Node* cycleTarget = getNodeAt(head, 2);
    tail->next = cycleTarget;
 
    printf("List built with an artificial cycle: 1->2->3->4->5->6->(back to 3)\n\n");
 
    detectCycle(head);
 
    return 0;
}


