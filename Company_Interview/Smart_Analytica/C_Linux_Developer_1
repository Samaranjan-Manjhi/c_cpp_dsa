```c
#include <sys/epoll.h>

int epfd = epoll_create1(0);
struct epoll_event ev, events[64];
ev.events = EPOLLIN;             // interested in "ready to read"
ev.data.fd = listen_fd;
epoll_ctl(epfd, EPOLL_CTL_ADD, listen_fd, &ev);

while (1) {
    int n = epoll_wait(epfd, events, 64, -1);  // blocks until events ready
    for (int i = 0; i < n; i++) {
        if (events[i].data.fd == listen_fd) {
            // accept new connection, add its fd to epoll
        } else {
            // read/write on events[i].data.fd
        }
    }
}
// WHY epoll > select/poll for high-performance servers:
// select/poll are O(n) — they re-scan the ENTIRE fd list every call.
// epoll is O(1) amortized — kernel maintains the interest list and
// only returns fds that are actually ready.
```

